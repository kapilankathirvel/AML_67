# Copy to .streamlit/secrets.toml for local use, or paste into Streamlit
# Community Cloud's "Secrets" box (Manage app -> Settings -> Secrets).
#
# secrets.toml is gitignored. This example is not — it documents the deployed
# configuration without shipping any value that matters.
#
# Streamlit exposes everything here as an environment variable, which is what
# backend/config.py reads, so no code needs to know about st.secrets.

# Which dataset the demo analyses. "synthetic" is the labelled 2,002-txn /
# 270-customer set that every number in README.md is computed against.
#
# Leave this at "synthetic" for a public demo. The application default is
# "synthetic_alt", a different population (1,710 txns / 294 customers) — a
# visitor who ran a query there and compared the customer count against the
# README would be right to wonder which of the two was made up.
AML_DATA_SOURCE = "synthetic"

# Real detection tools, not the mock ones used for agent-core development.
AML_USE_MOCKS = "0"

# Unset (or blank) means the backend runs inside the Streamlit process.
# Community Cloud runs one process and gives you no way to start a second, so
# this must stay blank there. Set it only when a separate FastAPI process is
# actually running somewhere.
AML_API_URL = ""

# --- LLM: deliberately off in public ------------------------------------
#
# Both stay "0" for a public demo, and that costs the demo nothing worth
# having. The regex intent parser covers all seven intents on its own and the
# deterministic planner is the floor, so every button works with no key at all.
#
# Turning them on in public would put a free-tier quota behind a URL anyone can
# click, and the first visitor to exhaust it would silently degrade the demo
# for everyone after them — including, potentially, whoever you sent the link
# to. Every published metric comes from the deterministic path anyway
# (run_evaluation pins both off regardless), so the demo with them off is the
# demo the numbers describe.
AML_LLM_PLANNER = "0"
AML_LLM_REPLANNER = "0"

# Only needed if you deliberately enable the LLM paths above. Leave blank
# otherwise — the app checks for a key and falls back cleanly when there
# isn't one.
# LLM_PROVIDER = "gemini"
# GEMINI_API_KEY = ""
# GROQ_API_KEY = ""
# OPENAI_API_KEY = ""
