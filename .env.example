# Copy to .env and fill in. Never commit .env.

# LLM provider: "gemini", "openai", "groq", or "ollama". Leave blank / omit key to run on the regex fallback.
# "ollama" runs fully locally (no key, no quota) — see OLLAMA_SETUP_MAC.md for Mac setup, or on Windows:
# install from https://ollama.com/download, then `ollama pull qwen2.5:7b-instruct`.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Only needed if not using the defaults (http://localhost:11434 / qwen2.5:7b-instruct):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# How long to keep the model in VRAM between calls (prevents cold-start reload).
# OLLAMA_KEEP_ALIVE=30m
# Per-call LLM timeout in seconds. 60s suits local Ollama 14B; 10s is fine for hosted APIs.
# LLM_TIMEOUT_SECONDS=60

# Use mock tools instead of Track B's real tools (1 = mocks, 0 = real).
# Real tools now exist (Phase 6) — use 0 for the actual demo. Mocks are only
# for developing the agent core in isolation, per WORKPLAN.md.
AML_USE_MOCKS=0

# Path to the working dataset (canonical-schema CSV). Also used by
# backend.agent.intent_parser to anchor relative dates ("last 30 days") to
# the dataset's own max date instead of wall-clock time.
AML_DATASET_PATH=data/sample/aml_sample.csv

# Which dataset /query and /dataset/summary analyse: "synthetic" |
# "synthetic_alt" | "ibm" | "ibm_stratified". Applied to the load_data step in
# backend/main.py, since the planner emits load_data with empty params.
#
# Defaults to "synthetic_alt", which is load_data's own default, so leaving
# this unset changes nothing. Set it to "synthetic" for anything a reader will
# compare against README.md: that is the labelled 2,002-txn / 270-customer set
# every published metric is computed against, whereas "synthetic_alt" is a
# different population (1,710 txns / 294 customers) with no shared IDs.
#
# Operator setting only. plan_validator V14 blocks an LLM plan from reaching
# load_data's source at all — a plan may choose how to analyse, not which
# dataset the product runs on.
AML_DATA_SOURCE=synthetic_alt

# Backend API URL, read by frontend/api_client.py (variable name must be
# exactly AML_API_URL — that's what the app actually reads).
#
# Set = the UI talks HTTP to that API, which is the two-process layout below.
# Blank or unset = the UI imports the backend and runs it in its own process.
# Single-process mode is what makes free hosts like Streamlit Community Cloud
# possible; see the "Deploying it" section of README.md.
AML_API_URL=http://localhost:8000

# Let the LLM choose which tools to run, instead of the deterministic
# intent -> tool table (1 = LLM planner, 0 = deterministic). The proposal is
# validated against backend/agent/plan_validator.py and falls back to the
# deterministic plan on any rejection, so this is safe to switch on — see the
# "Two planners" section of README.md.
#
# Defaults to 0. Leave it there for anything that must be reproducible:
# evaluation/run_evaluation.py pins it off regardless, so every published
# metric comes from the deterministic path.
AML_LLM_PLANNER=0

# Let the model revise the REMAINING steps mid-run, after seeing what the steps
# so far produced (1 = observe -> decide -> act loop, 0 = plan once up front).
# Revisions go through the same validator as the initial plan and are capped at
# 2 per request, plus 1 reserved for the case where a step actually failed;
# the executor's own re-planning rules remain underneath.
#
# Defaults to 0. Each intervention is an extra LLM round trip inside the
# request, and evaluation/run_evaluation.py pins it off regardless so no
# published metric can depend on a mid-flight model decision.
AML_LLM_REPLANNER=0
